{
  "name": "mdtidy",
  "version": "0.0.0",
  "description": "A fast Markdown formatter that streams, with Prettier's style by default",
  "license": "MIT",
  "author": "Luke Edwards <luke.edwards05@gmail.com> (https://lukeed.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeed/mdtidy.git",
    "directory": "crates/mdtidy_napi"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "markdown",
    "formatter",
    "prettier",
    "commonmark",
    "gfm"
  ],
  "napi": {
    "binaryName": "mdtidy",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "test": "bun test"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
