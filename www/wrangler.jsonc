{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tidy-docs",
  "compatibility_date": "2026-10-13",
  "main": "./worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only on these: crowne.io's two paths, the install script,
    // the release downloads, and `/`, where it chooses between the script and
    // the home page by user agent.
    "run_worker_first": [
      "/x/script.js",
      "/x",
      "/install.sh",
      "/download/*",
      "/",
    ],
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "tidy-releases" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "vars": {
    // The crowne.io site id. The key is a secret: wrangler secret put CROWNE_KEY
    "CROWNE_SITE": "01M6P92KE67F1WGBTFQY7EHERA",
  },
  "routes": [{ "pattern": "tidy.lukeed.com", "custom_domain": true }],
}
