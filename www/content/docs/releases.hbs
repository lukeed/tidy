---
title: Releases
summary: What changed in each release of tidy, newest first.
group: Misc
order: 3
---

{{#var releases = $utils.releases($pages)}}
<p>The
  <code>tidy</code>
  crate and command, and the
  <code>tidyrs</code>
  and
  <code>tidyrs-wasm</code>
  packages, share one version.</p>
<div class="releases" role="list">
  {{#each releases as release, i}}
    {{#var parts = release.headings.filter((heading) => heading.level === 2)}}
    <div role="listitem" {{#if i === 0}} class="latest"{{/if}}>
      <a href="{{ release.path }}">
        <span class="rel-top"><b>{{ release.title }}</b>{{#if i === 0}}<em
            >Latest</em>{{/if}}<time
            datetime="{{
              new Date(release.params.date).toISOString().slice(0, 10)
            }}"
          >{{
              $utils.date.format(release.params.date, {
                dateStyle: "medium",
                timeZone: "UTC",
              })
            }}</time></span>
        <span class="rel-sum">{{{ $utils.inline(release.summary) }}}</span>
        <span class="rel-foot">
          {{#if parts.length}}<span
              class="rel-parts"
            >{{#each parts as part}}<span>{{
                    part.text
                  }}</span>{{/each}}</span>{{/if}}
          <span class="rel-go">Notes &rarr;</span>
        </span>
      </a>
    </div>
  {{/each}}
</div>